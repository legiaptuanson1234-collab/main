# Mẫu biến môi trường cho pipeline (không chứa secret thật).
# Ollama chạy cục bộ không cần API key; các giá trị dưới đây chỉ là cấu hình.

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=600000
# Chế độ mặc định khi không truyền --mode (draft | review | publish | dry-run)
PIPELINE_MODE=draft
# Đặt 1 để test pipeline không cần Ollama
#PIPELINE_MOCK=1
