---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  description = 'Sổ Tay AI — danh bạ công cụ AI miễn phí và hướng dẫn bắt đầu cho người mới.',
  canonical,
  noindex,
} = Astro.props;

const site = import.meta.env.SITE_URL;
const og = canonical ? new URL(canonical, site).href : undefined;
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {og && <link rel="canonical" href={og} />}
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sổ Tay AI" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  {og && <meta property="og:url" content={og} />}
  <meta property="og:locale" content="vi_VN" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Sổ Tay AI" href="/guides/feed.xml" />
</head>
<body>
  <a class="skip-link" href="#main">Bỏ qua điều hướng</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
